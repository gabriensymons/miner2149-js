{
  "name": "miner2149-js",
  "version": "1.0.0",
  "private": true,
  "description": "A browser-based reimplementation of Michael Baker's Miner2149 for Palm OS.",
  "type": "module",
  "scripts": {
    "build": "npm run check && node tools/build-static.js",
    "check": "node tools/check-source.js",
    "dev": "http-server . -p 8080 -c-1",
    "test": "node --test test/*.test.js",
    "test:smoke": "npm run build && playwright test",
    "verify": "npm test && npm run test:smoke && npm audit --audit-level=high",
    "vendor:pixi": "node tools/vendor-pixi.js"
  },
  "engines": {
    "node": "20.x || 22.x"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "http-server": "14.1.1",
    "pixi.js": "8.20.1"
  },
  "overrides": {
    "async": "2.6.4",
    "follow-redirects": "1.16.0",
    "lodash": "4.18.1"
  }
}
